rules_version = '2';

// STAGE 3 RULES — adds `deposits` and `notifications` collections.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{uid} {
      // Anyone signed in can read a user profile — needed so referral
      // lookups (find user by referral code) and admin views work.
      // Nothing sensitive (password, etc.) is ever stored here; Firebase
      // Auth handles credentials separately and they never touch Firestore.
      allow read: if isSignedIn();

      // A user may only create their OWN profile document (uid must match),
      // and may not set their own role to "admin" — role starts as "user"
      // and can only be escalated by an existing admin via updateAdmin.
      allow create: if isOwner(uid) && request.resource.data.role == "user";

      // A user may update their own profile, but never change their own
      // role, referralCode, referrerCode, or referrerOfReferrerCode —
      // those fields are only ever written by trusted flows (set once at
      // registration in services/auth.js, or directly by an admin via the
      // Manage Users screen).
      //
      // referralLifetimeWithdrawn and welcomeBonus are a special case:
      // welcomeBonus a user IS allowed to DECREASE (withdrawing it via the
      // combined withdrawal flow, services/withdrawalRequests.js), but
      // never INCREASE — increases only ever come from a trusted flow (the
      // one-time welcome bonus set at account creation).
      // referralLifetimeWithdrawn is the OPPOSITE shape: a user IS allowed
      // to INCREASE it (that's what happens when they draw down their
      // live-computed referral balance via a withdrawal), but never
      // DECREASE it as themselves — decreases only happen via
      // rejectCombinedWithdrawal, which is only ever called from the admin
      // queue (AdminDepositsPage.jsx) and therefore always runs as an
      // admin, hitting the `|| isAdmin()` escape hatch below rather than
      // this monotonic-increase check. This mirrors the exact same pattern
      // already used for deposits' lifetimeWithdrawn and checkins'
      // lifetimeWithdrawn elsewhere in this file — referral bonus itself
      // is never STORED (it's live-computed from the referred users' real
      // deposit/review history, see services/referralEarnings.js), only
      // the withdrawn-so-far counter is.
      //
      // An admin may update ANY field on ANY user's document (role
      // changes, manual corrections, etc.)
      allow update: if (isOwner(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.referralCode == resource.data.referralCode &&
        request.resource.data.referrerCode == resource.data.referrerCode &&
        request.resource.data.get("referrerOfReferrerCode", "") == resource.data.get("referrerOfReferrerCode", "") &&
        request.resource.data.get("referralLifetimeWithdrawn", 0) >= resource.data.get("referralLifetimeWithdrawn", 0) &&
        request.resource.data.get("welcomeBonus", 0) <= resource.data.get("welcomeBonus", 0))
        || isAdmin();

      allow delete: if isAdmin();
    }

    match /deposits/{depositId} {
      // Any signed-in user can read deposits — needed for the admin queue
      // to see everyone's deposits, and simplest for a small app without
      // Cloud Functions to enforce per-user read filtering server-side.
      // Nothing here is more sensitive than what a user already sees about
      // themselves; other users' deposit amounts aren't shown in the UI.
      allow read: if isSignedIn();

      // A user may create a deposit only for themselves, and it must start
      // as "pending" with no approval data and zero lifetimeWithdrawn —
      // preventing a forged pre-approved or already-partially-withdrawn
      // deposit from being submitted directly.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.lifetimeWithdrawn == 0 &&
        !("approvedAt" in request.resource.data);

      // Admins can update anything (approve, reject, mark withdrawals paid).
      //
      // A user may update ONLY their own approved deposit, and ONLY to
      // submit a withdrawal request — every other field must stay
      // identical to what's already stored. This still trusts the client
      // to compute lifetimeWithdrawn/amount correctly (there's no Cloud
      // Function here to independently verify the earnings math), so a
      // technically sophisticated user could tamper with this from
      // dev tools. Closing that gap fully would require moving the
      // withdrawal-balance calculation into a Cloud Function — noted as a
      // known limitation of the current backend-function-free architecture.
      allow update: if isAdmin() || (
        isOwner(resource.data.userId) &&
        resource.data.status == "approved" &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.approvedAt == resource.data.approvedAt &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.planId == resource.data.planId &&
        request.resource.data.planDaily == resource.data.planDaily
      );

      allow delete: if isAdmin();
    }

    match /notifications/{notifId} {
      // A user can read/update (mark read) only their own notifications.
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;

      // Notifications are created by trusted app flows (deposit approval,
      // referral bonus, withdrawal request) acting on behalf of a signed-in
      // user — allow any signed-in user to create one, since there's no
      // Cloud Function to originate these server-side instead.
      allow create: if isSignedIn();

      allow delete: if isAdmin();
    }

    match /checkins/{userId} {
      // Document ID IS the user's uid, so ownership is a direct path
      // comparison rather than needing a userId field check.
      //
      // NOTE: this collection now holds real money (a ₦700 reward
      // unlockable after a 7-day streak). Like the deposits withdrawal
      // path elsewhere in this file, there's no Cloud Function here to
      // independently verify the streak math server-side — a technically
      // sophisticated user could edit their own document's unlockedBalance
      // directly via dev tools. Closing that gap fully would require
      // moving the streak/reward calculation into a Cloud Function. Noted
      // as a known limitation of the current backend-function-free
      // architecture, consistent with the same tradeoff already accepted
      // for VIP withdrawals.
      allow read, write: if isOwner(userId);
    }

    match /reviews/{userId} {
      // Document ID IS the user's uid. Tracks which WAT calendar days a
      // user fully READ all featured articles (Read & Earn), and today's
      // in-progress reads. Collection name and internal field names
      // (lastRatingAt, lastRatingDate) are unchanged from this feature's
      // earlier star-rating incarnation ("Daily Reviews") — see
      // services/reviews.js for why those were deliberately kept rather
      // than renamed.
      //
      // NOTE: the stakes here are higher than most other self-owned
      // collections in this file. Because a day's ENTIRE VIP earning is
      // gated behind completedDays (not a partial share), a technically
      // sophisticated user editing their own document via dev tools could
      // fabricate a completed reading day and unlock 100% of that day's
      // earnings without actually reading anything. This is the same
      // class of "no Cloud Function to verify server-side" limitation as
      // checkins and deposits withdrawals elsewhere in this file, but the
      // potential impact per act of tampering is larger here. Closing
      // this fully would require moving completedDays writes into a
      // Cloud Function that independently verifies real article reads
      // were submitted — flagged as a priority follow-up if this feature
      // sees real usage, not just a passive note.
      allow read, write: if isOwner(userId);
    }

    match /withdrawalRequests/{requestId} {
      // Combines VIP profit + Referral Bonus + Welcome Bonus + Check-in
      // balance into ONE withdrawal request per the site owner's request
      // to stop showing these as separate withdrawable "tags." The actual
      // balance deductions happen in the SAME client-side transaction
      // that creates this document (see services/withdrawalRequests.js
      // requestCombinedWithdrawal) — across users/checkins/deposits — so
      // this document is primarily a record of what was requested and
      // from where, for admin visibility and for exactly reversing the
      // deduction if the request is later rejected.
      //
      // Any signed-in user can read (same reasoning as deposits: needed
      // for the admin queue, and nothing here is more sensitive than data
      // a user already sees about their own withdrawal history).
      allow read: if isSignedIn();

      // A user may create a request only for themselves, starting as
      // "pending" with no paidAt/decidedAt yet — preventing a forged
      // pre-approved withdrawal from being submitted directly. This does
      // NOT independently verify the breakdown amounts are correct or
      // that the underlying balances were genuinely sufficient — that
      // check happens client-side before the transaction runs. Same
      // "no Cloud Function to verify server-side" limitation noted
      // elsewhere in this file; the deduction transaction itself (see
      // the users/checkins/deposits update rules above) is what actually
      // prevents a user from creating a request for MORE than they have,
      // since those rules require balances to only ever decrease.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == "pending" &&
        !("paidAt" in request.resource.data) &&
        !("decidedAt" in request.resource.data);

      // Only an admin may update a request (mark paid / reject) — a user
      // can never edit their own request after submitting it, preventing
      // e.g. a rejected request from being silently flipped back to
      // "pending" or "paid" by the user themselves.
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }
  }
}
